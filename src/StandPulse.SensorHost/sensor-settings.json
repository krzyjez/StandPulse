    "deviceId": "d885ac1745e4",
    "authKeyEnvironmentVariable": "STANDPULSE_SHELLY_AUTH_KEY",
    "channel": 0,
    "commandTimeoutSeconds": 10,
    "retryCount": 2
  },
  "fake": {
    "intervalMilliseconds": 500,
    "samples": [
      {
        "event": null,
        "present": true,
        "targetStatus": "StaticTarget",
        "distanceCm": 64,
        "repeat": 12
      },
      {
        "event": null,
        "present": false,
        "targetStatus": "NoTarget",
        "distanceCm": null,
        "repeat": 12
      }
