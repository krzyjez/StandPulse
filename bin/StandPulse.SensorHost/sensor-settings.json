{
  "source": {
    "mode": "serial"
  },
  "serial": {
    "portName": "COM4",
    "baudRate": 115200
  },
  "presence": {
    "maxDistanceCm": 200,
    "stateChangeDelaySeconds": 10,
    "sampleTimeoutSeconds": 5,
    "maxConsecutiveSensorErrors": 3,
    "maxStartupInvalidLines": 20
  },
  "pipe": {
    "name": "StandPulse.Sensor"
  },
  "effectors": {
    "directory": "effectors"
  },
  "fake": {
    "intervalMilliseconds": 500,
    "samples": [
      {
        "event": null,
        "present": true,
        "targetStatus": "StaticTarget",
        "distanceCm": 64,
        "repeat": 12
      },
      {
        "event": null,
        "present": false,
        "targetStatus": "NoTarget",
        "distanceCm": null,
        "repeat": 12
      }
    ]
  }
}
